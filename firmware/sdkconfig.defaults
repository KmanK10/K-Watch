# Flash and PSRAM (T-Watch S3: 16MB QIO flash, 8MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console over the S3's built-in USB (the watch has no USB-UART chip).
# While a computer is connected, stay out of light sleep so logging and
# flashing keep working. On a plain charger the watch sleeps normally.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Power management: frequency scaling + automatic light sleep when idle
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# app_main runs LVGL; drawing flex layouts and rounded buttons needs far more than the 3.5KB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Bluetooth LE (NimBLE): one iPhone connection, bonded, GATT client for ANCS/CTS.
# The GATT client needs the central role compiled in; scanning stays off.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="K-Watch"
CONFIG_BT_NIMBLE_SVC_GAP_APPEARANCE=0xC1
# Let the radio sleep between connection events, including during light sleep.
# There is no 32kHz crystal on the ESP32 here, so the main crystal keeps time.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
# Widgets come from the normal heap (internal RAM first, then PSRAM), not a fixed
# 48KB pool that every screen and notification shares and can run out of.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_BUILD_EXAMPLES=n

# Catch bugs early
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
